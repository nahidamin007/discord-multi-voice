# Dashboard listening address (default: 0.0.0.0)
HOST=0.0.0.0

# Dashboard port (default: 8080)
PORT=8080

# Dashboard login password (default: admin123)
DASHBOARD_PASSWORD=admin123

# Secret key used to sign JWT; auto-generated if left empty
JWT_SECRET=

# JWT signing algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT validity period in hours (default: 72)
JWT_EXPIRE_HOURS=72

# Filename containing Discord tokens (default: tokens.txt)
TOKENS_FILE=tokens.txt

# Or pass tokens directly via environment (newline, comma, or semicolon separated):
# TOKENS=token1,token2,token3

# Auto-start bots on launch without needing manual click in web dashboard (true/false)
AUTO_START=false

# Channel ID(s) for auto-start (comma separated if multiple)
CHANNEL_IDS=

# Keep-alive URL for free hosting (Render/UptimeRobot). Render automatically sets RENDER_EXTERNAL_URL
KEEP_ALIVE_URL=

# Enable Cloudflare Tunnel: true or false (default: false on cloud, true if cloudflared is installed locally)
ENABLE_TUNNEL=false

# Path to the cloudflared executable
CLOUDFLARED_PATH=/usr/local/bin/cloudflared